# Copy to .env and fill in. Nothing in here is ever committed, logged, or returned by a capability —
# the core strips secret-named values on the way out and fingerprints them where a comparison is
# genuinely needed.
#
# Referenced from argus.config.json as ${VARIABLE_NAME}. A referenced variable that is unset makes
# `argus doctor` fail loudly rather than letting a device silently drop out of the picture.

# --- Gateway (the box the line comes into) -------------------------------------
GATEWAY_HOST=
GATEWAY_PASSWORD=

# --- Access point ---------------------------------------------------------------
AP_HOST=
AP_USER=admin
AP_PASSWORD=

# --- Powerline / mesh adapter ---------------------------------------------------
PLUG_HOST=
PLUG_PASSWORD=

# --- Tailscale ------------------------------------------------------------------
# Tailnet name, e.g. example.com or tail1234.ts.net
TAILSCALE_TAILNET=
# API access token from the admin console (Settings → Keys). Read-only is enough unless you
# want routes.approve to work.
TAILSCALE_API_KEY=

# --- Optional -------------------------------------------------------------------
# The network name you want every access point to agree on, if you use ssid.set.
UNIFIED_SSID=
